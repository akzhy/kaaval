{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kaaval",
  "version": "0.0.1",
  "identifier": "com.akzhy.kaaval",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kaaval",
        "width": 1000,
        "height": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERDN0UwQzE1NkMzRUEzNUYKUldSZm96NXNGUXgrM0haZXRMenBDOFNtRURva0F3TGlvcS9zR1RzMERWQXgzLzMvSzJxMjlvSWcK",
      "endpoints": [
        "https://github.com/akzhy/kaaval/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
